&mt LEFT_COMMAND Z  &kp X     &kp C      &kp V     &kp B                          &kp N     &kp M  &kp COMMA  &kp DOT   &kp SLASH
&kp LSHIFT          &kp LGUI  &kp LCTRL  &kp LALT  &kp SPACE  &mo 1  &lt 2 ENTER  &kp BSPC                    &kp LBKT  &kp INT_RO
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        layer_1 {
            bindings = <
&kp LG(W)  &kp LG(LS(T))   &msc SCRL_UP    &kp RALT         &enter_pass                  &kp N1    &kp N2   &kp N3    &kp N4    &kp N5
&none      &mkp MB3        &mkp MB2        &mkp MB1         &none                        &kp N6    &kp N7   &kp N8    &kp N9    &kp N0
&none      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &none                        &kp SEMI  &kp SQT  &kp RBKT  &kp BSLH  &kp INT_YEN
&trans     &trans          &trans          &trans           &trans       &trans  &trans  &trans                       &trans    &kp LBKT
