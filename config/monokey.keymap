&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <150>;
    quick-tap-ms = <250>;
};

&lt {
    tapping-term-ms = <150>;
    quick-tap-ms = <250>;
    flavor = "tap-preferred";
};

/ {
    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
            timeout-ms = <50>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
            timeout-ms = <50>;
        };

        scroll {
            bindings = <&mo 5>;
            key-positions = <8 9>;
            timeout-ms = <50>;
        };

        eisu {
            bindings = <&kp LANG2>;
            key-positions = <23 24>;
            timeout-ms = <50>;
        };

        kana {
            bindings = <&kp LANG1>;
            key-positions = <25 26>;
            timeout-ms = <50>;
        };

        gesture {
            bindings = <&mo 13>;
            key-positions = <18 19>;
            timeout-ms = <50>;
        };
    };

    macros {
        enter_pass: enter_pass {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A>;
            label = "ENTER_PASS";
        };
    };

    keymap {
